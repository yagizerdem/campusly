generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model Profile { 
  id    String     @id @default(uuid()) 
  firstName String
  lastName String
  telephoneNumber String?

  administeredClubs Club[]
  likes Like[]
  comments Comment[]
  posts Post[]
  clubJoinRequests ClubJoinRequest[]
  clubMemberships ClubMember[]

  profileImage Image? @relation(fields: [profileImageId], references: [id])
  profileImageId String? @unique


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Club { 
  id    String     @id @default(uuid()) 
  clubName String
  clubNormalizedName String @unique
  clubDescription String
  clubLogoUri String?

  clubAdmin Profile @relation(fields: [clubAdminId], references: [id])
  clubAdminId String  // Foreign key connecting Club to Profile

  posts Post[]
  tagsOnClubs TagsOnClub[]
  clubJoinRequests ClubJoinRequest[]
  clubMembers ClubMember[]

  clubLogo   Image?  @relation(fields: [clubLogoId], references: [id])
  clubLogoId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Post {
  id    String     @id @default(uuid()) 
  postTitle String
  postContent String

  club Club @relation(fields: [clubId], references: [id])
  clubId String  // Foreign key connecting Post to Club

  author   Profile @relation(fields: [authorId], references: [id])
  authorId String

  likes Like[]
  comments Comment[]
  images PostImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostImage {
  postId  String
  imageId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  order Int @default(0)

  @@id([postId, imageId])
}


model Like {
  id    String     @id @default(uuid()) 

  post Post @relation(fields: [postId], references: [id])
  postId String  // Foreign key connecting Like to Post

  profile Profile @relation(fields: [profileId], references: [id])
  profileId String  // Foreign key connecting Like to Profile

  createdAt DateTime @default(now())

  @@unique([postId, profileId]) // Ensures a user can like a post only once
}

model Comment {
  id    String     @id @default(uuid()) 
  commentContent String

  post Post @relation(fields: [postId], references: [id])
  postId String  // Foreign key connecting Comment to Post

  profile Profile @relation(fields: [profileId], references: [id])
  profileId String  // Foreign key connecting Like to Profile

  createdAt DateTime @default(now())
}

model Image {
  id    String     @id @default(uuid()) 
  imageUri String
  fileName String
  bucketName String
  mimeType String

  profile    Profile?
  club       Club?
  posts      PostImage[]

  createdAt DateTime @default(now())
}

model Tag {
  id    String     @id @default(uuid()) 
  tagName String @unique  
  tagsOnClubs TagsOnClub[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TagsOnClub {
  tag Tag @relation(fields: [tagId], references: [id])
  tagId String

  club Club @relation(fields: [clubId], references: [id])
  clubId String

  @@id([tagId, clubId])
}


model ClubJoinRequest {
  id    String     @id @default(uuid()) 

  club Club @relation(fields: [clubId], references: [id])
  clubId String  // Foreign key connecting ClubJoinRequest to Club

  profile Profile @relation(fields: [profileId], references: [id])
  profileId String  // Foreign key connecting ClubJoinRequest to Profile

  status JoinRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClubMember {
  id    String     @id @default(uuid()) 

  club Club @relation(fields: [clubId], references: [id])
  clubId String  // Foreign key connecting ClubMember to Club

  profile Profile @relation(fields: [profileId], references: [id])
  profileId String  // Foreign key connecting ClubMember to Profile

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, clubId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED 
}





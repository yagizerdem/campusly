generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model Profile { 
  id    String     @id @default(uuid()) 
  firstName String
  lastName String
  profilePicUri String?
  telephoneNumber String?

  administeredClubs Club[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Club { 
  id    String     @id @default(uuid()) 
  clubName String
  clubDescription String
  clubLogoUri String?

  clubAdmin Profile @relation(fields: [clubAdminId], references: [id])
  clubAdminId String  // Foreign key connecting Club to Profile

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}







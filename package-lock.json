{
  "name": "campusly",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "campusly",
      "version": "1.0.0",
      "workspaces": [
        "packages/shared",
        "packages/types"
      ]
    },
    "node_modules/@campusly/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@campusly/types": {
      "resolved": "packages/types",
      "link": true
    },
    "packages/shared": {
      "name": "@campusly/shared",
      "version": "1.0.0",
      "dependencies": {
        "zod": "^4.4.3"
      }
    },
    "packages/shared/node_modules/zod": {
      "version": "4.4.3",
      "license": "MIT",
      "funding": {
        "url": "https://github.com/sponsors/colinhacks"
      }
    },
    "packages/types": {
      "name": "@campusly/types",
      "version": "1.0.0"
    }
  }
}
